nfWorkDir="nfwork"

outputDir = "${nfWorkDir}/out"
workDir = "${nfWorkDir}/work"

profiles {
    local {
        params.executor = 'local'
        process {
            executor = 'local'
        }
    }
    slurm {
        params.executor = 'slurm'
        process {
            executor = 'slurm'
            queue = 'debug'
        }
    }
    sge {
        params.executor = 'sge'
        process {
            executor = 'sge'
        }
    }
}

apptainer {
    enabled = true
    autoMounts = true
    runOptions = "--no-home -B ${launchDir}"
}

process {
    executor = 'local'
}

params {
    executor = "local"
    petagenomeDir = "${projectDir}/.."
    output = "${nfWorkDir}/out"
    memory = "32"
    threads = 16
    cpus = 1
    random_seed = 0
    publish_output = true
    apptainerRunOptions = apptainer.runOptions
    use_pzlast = false
}

trace.overwrite    = true
report.overwrite   = true
timeline.overwrite = true
dag.overwrite      = true
